# Amanda environment template
# Copy this file to `.env` for local development.
# For production, set these as environment variables in your cloud provider.
# NEVER commit your real `.env` file.

# ── Server ───────────────────────────────────────────────────────────────────
# Local default: 3000. Cloud Run injects PORT automatically.
PORT=3000
NODE_ENV=development

# Production URLs — replace with your deployed backend / frontend URLs.
# Leave blank for local same-origin development.
BASE_URL=
FRONTEND_URL=
API_BASE_URL=

# ── Amanda Core ──────────────────────────────────────────────────────────────
# Required for storing OAuth tokens securely. Use a long random string.
AMANDA_TOKEN_SECRET=

# Override the database path for testing. Leave blank for normal use.
# Production should use the default: data/db.json (or migrate to a real DB).
AMANDA_DB_PATH=

# Set true only to enable seeded mock/demo connector data in the UI.
AMANDA_DEMO_MODE=false

# Shows voice request trace panel outside NODE_ENV=development.
AMANDA_DEBUG_VOICE=false

# ── Google OAuth (shared for Sign-In, Calendar, Gmail, Sheets) ───────────────
# Create an OAuth 2.0 Web Application client at console.cloud.google.com.
# Add ALL redirect URIs below to "Authorized redirect URIs" in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sign-In (OpenID Connect — identity only, no data access)
# Local:
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Production (uncomment and set):
# GOOGLE_AUTH_REDIRECT_URI=https://YOUR_BACKEND_URL/api/auth/google/callback

# Google Workspace (combined permissions after sign-in)
# Local:
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3000/api/auth/google/workspace/callback
# Production (uncomment and set):
# GOOGLE_WORKSPACE_REDIRECT_URI=https://YOUR_BACKEND_URL/api/auth/google/workspace/callback

# ── Google Calendar connector ────────────────────────────────────────────────
# Read-only:  https://www.googleapis.com/auth/calendar.readonly
# With event creation approval: https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
# Local:
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/connectors/google_calendar/callback
# Production (uncomment and set):
# GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_BACKEND_URL/api/connectors/google_calendar/callback

# ── Gmail connector ──────────────────────────────────────────────────────────
# Read-only:   https://www.googleapis.com/auth/gmail.readonly
# With drafts: https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose
# After changing scopes: restart Amanda, disconnect Gmail, reconnect.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose
# Local:
GMAIL_REDIRECT_URI=http://localhost:3000/api/connectors/gmail/callback
# Production (uncomment and set):
# GMAIL_REDIRECT_URI=https://YOUR_BACKEND_URL/api/connectors/gmail/callback

# ── Google Sheets connector ──────────────────────────────────────────────────
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly
# Local:
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:3000/api/connectors/google_sheets/callback
# Production (uncomment and set):
# GOOGLE_SHEETS_REDIRECT_URI=https://YOUR_BACKEND_URL/api/connectors/google_sheets/callback

# ── Gemini backend brain ─────────────────────────────────────────────────────
# Optional. If missing, Amanda falls back to the local deterministic brain.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Amanda TTS voice provider ────────────────────────────────────────────────
# webspeech  — browser Web Speech only (default, no key required)
# elevenlabs — ElevenLabs via backend, falls back to Web Speech on failure
# Restart server after changing.
AMANDA_TTS_PROVIDER=webspeech

# ElevenLabs — backend-only. Key is NEVER sent to the frontend.
# Do not commit a real key. Keep only in local .env or cloud secret manager.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ── Website Connector ────────────────────────────────────────────────────────
# Optional webhook secret for mock e-commerce site → Amanda event posting.
# If set, POST /api/connectors/website/events accepts x-amanda-website-secret header.
# Do not commit a real secret.
WEBSITE_CONNECTOR_SECRET=
# When webhook auth is used, events are assigned to this user ID.
# Falls back to first user in development/demo mode if not set.
WEBSITE_CONNECTOR_DEFAULT_USER_ID=
