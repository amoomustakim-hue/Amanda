# Amanda local environment template
# Copy this file to `.env` for local development.
# Never commit your real `.env` file.

# Server
PORT=3000
NODE_ENV=development

# Enables seeded mock/demo connector data in the UI.
# Keep false for real product testing.
AMANDA_DEMO_MODE=false

# Shows the voice request trace panel outside NODE_ENV=development.
# Keep false unless actively debugging voice routing.
AMANDA_DEBUG_VOICE=false

# Gemini backend brain
# Gemini thinks; Amanda's backend still executes tools and enforces approval policy.
GEMINI_API_KEY=[GEMINI_API_KEY]
GEMINI_MODEL=gemini-1.5-flash

# Amanda TTS voice provider
# Use webspeech during development (no API key required).
# Use elevenlabs during demo if ELEVENLABS_API_KEY is configured.
# Restart the server after changing this setting.
# webspeech  — browser Web Speech only, no round-trip to backend TTS
# elevenlabs — ElevenLabs via backend, falls back to Web Speech on any failure
AMANDA_TTS_PROVIDER=webspeech

# ElevenLabs TTS — backend-only, key is NEVER sent to the frontend
# Do not commit .env with a real key. Keep ELEVENLABS_API_KEY only in local .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Local database override for testing
# Leave empty for normal local development.
AMANDA_DB_PATH=

# Token encryption secret
# Required for storing real connector OAuth tokens.
# Use a long random string in your real `.env`.
AMANDA_TOKEN_SECRET=

# Google Calendar OAuth
# Read-only sync can use: https://www.googleapis.com/auth/calendar.readonly
# Approved event creation requires: https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/connectors/google_calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3010/api/connectors/google_calendar/callback
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events

# Gmail OAuth
# Read-only sync:
#   https://www.googleapis.com/auth/gmail.readonly
# Real Gmail draft creation after approval:
#   https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose
# After changing scopes:
# 1. Restart Amanda
# 2. Disconnect Gmail
# 3. Reconnect Gmail
GMAIL_REDIRECT_URI=http://localhost:3010/api/connectors/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Google Sheets read-only connector
# Requires the same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as Calendar/Gmail.
# Add this redirect URI to Authorized redirect URIs in Google Cloud OAuth client.
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:3010/api/connectors/google_sheets/callback

# Future Shopify connector
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_customers
SHOPIFY_APP_URL=http://localhost:3000

# Future Slack connector
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Future WhatsApp Business connector
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Future payment connectors
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
